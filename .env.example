# Skopiuj do .env i wpisz własne klucze. Plik .env jest w .gitignore.

# Lektor, efekty dźwiękowe (ElevenLabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Warstwa "film z prompta" (OpenAI)
OPENAI_API_KEY=
# Opcjonalnie: przypnij konkretny model; puste = wybór z listy modeli konta
VIDEOMAT_LLM_MODEL=

# Avatar i plansze (Gemini/Veo) — płatne, wymaga włączonego rozliczenia
GEMINI_API_KEY=

# Opcjonalnie: whisper (tiny|base|small|medium|large-v3), domyślnie small
WHISPER_MODEL=small
# Opcjonalnie: wymuś enkoder (nvenc|x264); puste = auto-detekcja
VIDEOMAT_ENCODER=
