 "narration": [
  {
   "id": "vo01",
   "text": "Wiktoria pyta już któryś raz: czyimi głosami Ociepa miał wygrać? Dobrze. To wytłumaczmy to… na klockach.",
   "fallback": 7.5,
   "gain_db": 3.0
  },
  {
   "id": "vo02",
   "text": "Najpierw mały szczegół. Mateusz Morawiecki sam publicznie popiera Marcina Ociepę. Ba. Nazywa się ojcem chrzestnym tej kandydatury.",
   "fallback": 8.0,
   "gain_db": 3.0
  },
  {
   "id": "vo03",
   "text": "Potem prawica pęka. Powstaje osobny klub Morawieckiego. I od tego momentu sprawa Ociepy przestaje być wyłącznie walką o jeden fotel.",
   "fallback": 8.5,
   "gain_db": 3.0
  },
  {
   "id": "vo04",
   "text": "Piękna rada. Serio. Tylko w polityce warto jeszcze podążać… za własną pamięcią.",
   "fallback": 5.5,
   "gain_db": 3.0
  },
  {
   "id": "vo05",
   "text": "Bo ojciec chrzestny chyba powinien pamiętać, czyjego był chrztu.",
   "fallback": 4.3,
   "gain_db": 3.0
  },
  {
   "id": "vo06",
   "text": "I teraz dowód koronny: ktoś z OdNowy… był na wydarzeniu innego środowiska. O nie.",
   "fallback": 5.5,
   "gain_db": 3.0
  },
  {
   "id": "vo07",
   "text": "Wiktoria. Konferencja to nie ślub. Spotkanie to nie koalicja. A kawa na evencie nie jest umową polityczną.",
   "fallback": 6.5,
   "gain_db": 3.0
  },
  {
   "id": "vo08",
   "text": "Można rozmawiać z każdym. Pytanie brzmi, co robisz, kiedy przychodzi moment decyzji.",
   "fallback": 5.8,
   "gain_db": 3.0
  },
  {
   "id": "vo09",
   "text": "Żeby było uczciwie: Rozwój Plus proponował powiększenie Prezydium. Dwa dodatkowe miejsca — dla siebie i Centrum.",
   "fallback": 6.3,
   "gain_db": 3.0
  },
  {
   "id": "vo10",
   "text": "To jest argument. Tylko że chwilę później przyszedł test praktyczny.",
   "fallback": 4.3,
   "gain_db": 3.0
  },
  {
   "id": "vo11",
   "text": "Horała — dwieście pięćdziesiąt cztery. Ociepa — sto sześćdziesiąt siedem. A za Horałą? Między innymi sto czterdziestu dziewięciu posłów Koalicji Obywatelskiej.",
   "fallback": 8.5,
   "gain_db": 3.0
  },
  {
   "id": "vo12",
   "text": "I proszę zauważyć: ja nie mówię „tajny deal”. Nie muszę. Mówię: wynik głosowania.",
   "fallback": 6.0,
   "gain_db": 3.0
  },
  {
   "id": "vo13",
   "text": "Więc czyimi głosami miał wygrać Ociepa? Powiem jeszcze raz: nie o gwarancję jego wygranej chodziło.",
   "fallback": 6.5,
   "gain_db": 3.0
  },
  {
   "id": "vo14",
   "text": "Chodziło o to, czy ludzie, którzy jeszcze chwilę wcześniej tworzyli jeden obóz, spróbują go ponownie skleić… czy wykorzystają pierwszą okazję, żeby pokazać, że podział jest już trwały.",
   "fallback": 10.5,
   "gain_db": 3.0
  },
  {
   "id": "vo15",
   "text": "Ociepa mógł przegrać. Polityka zna porażki.",
   "fallback": 3.0,
   "gain_db": 3.0
  },
  {
   "id": "vo16",
   "text": "Ale można przegrać próbując zjednoczyć swoje środowisko… albo wygrać fotel pokazując wszystkim, jak głęboki jest już rozłam.",
   "fallback": 7.3,
   "gain_db": 3.0
  },
  {
   "id": "vo17",
   "text": "Więc tak, młodzi. Podążajcie za głosem serca. Ale zabierzcie ze sobą trzy rzeczy: pamięć… kalkulator… i wyniki głosowań.",
   "fallback": 8.0,
   "gain_db": 3.0
  },
  {
   "id": "vo18",
   "text": "Wiktoria pyta: czyimi głosami miał wygrać Ociepa? Ja zapytam inaczej: skoro chodziło o jedność prawicy — czyimi głosami postanowiliście pokazać, że tej jedności już nie ma?",
   "fallback": 10.0,
   "gain_db": 3.0
  }
 ],
