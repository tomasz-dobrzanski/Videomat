 "narration": [
  {
   "id": "vo01a",
   "text": "Wiktoria pyta już któryś raz: czyimi głosami Ociepa miał wygrać?",
   "fallback": 4.2,
   "gain_db": 3.0
  },
  {
   "id": "vo04",
   "text": "Piękna rada. Serio. Tylko w polityce warto jeszcze podążać… za własną pamięcią.",
   "fallback": 4.7,
   "gain_db": 3.0
  },
  {
   "id": "vo05",
   "text": "Bo ojciec chrzestny chyba powinien pamiętać, czyjego był chrztu.",
   "fallback": 4.0,
   "gain_db": 3.0
  },
  {
   "id": "vo08",
   "text": "Można rozmawiać z każdym. Pytanie brzmi, co robisz, kiedy przychodzi moment decyzji.",
   "fallback": 4.9,
   "gain_db": 3.0
  },
  {
   "id": "vo15",
   "text": "Ociepa mógł przegrać. Polityka zna porażki.",
   "fallback": 3.0,
   "gain_db": 3.0
  },
  {
   "id": "vo16",
   "text": "Ale można przegrać próbując zjednoczyć swoje środowisko… albo wygrać fotel pokazując wszystkim, jak głęboki jest już rozłam.",
   "fallback": 7.7,
   "gain_db": 3.0
  },
  {
   "id": "vo18b",
   "text": "Skoro chodziło o jedność prawicy — czyimi głosami postanowiliście pokazać, że tej jedności już nie ma?",
   "fallback": 6.1,
   "gain_db": 3.0
  }
 ],
