   "gain_db": 3.5
  },
  {
   "id": "vo3",
   "text": "Kilka tygodni później Rozwój Plus wystawia własnego kandydata.",
   "fallback": 3.766896,
   "gain_db": 3.5
  },
  {
   "id": "vo4",
   "text": "I to on zostaje wicemarszałkiem.",
   "fallback": 1.898292,
   "gain_db": 3.5
  },
  {
   "id": "vo7",
   "text": "Morawiecki i cały jego klub głosują przeciw Marcinowi Ociepie.",
   "fallback": 3.611396,
   "gain_db": 3.5
  },
  {
   "id": "vo8",
   "text": "Obiecał głos. Zagłosował przeciw.",
