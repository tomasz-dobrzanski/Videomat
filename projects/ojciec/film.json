  {
   "id": "vo1",
   "text": "U słynnego Ojca Chrzestnego, Vito Corleone, zdrada była zwrotem akcji.",
   "fallback": 4.419375,
   "gain_db": 3.5
  },
  {
   "id": "vo2",
   "text": "Tutaj zwrot akcji zaczął się już w napisach początkowych.",
