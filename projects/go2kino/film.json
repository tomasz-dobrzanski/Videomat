 "narration": [
  {
   "id": "vo1",
   "text": "Innowacje potrzebują pionierów.",
   "fallback": 3.0,
   "gain_db": 3.0
  },
  {
   "id": "vo2",
   "text": "Tych, którzy widzą wcześniej. I działają, zanim pojawi się problem.",
   "fallback": 3.0,
   "gain_db": 3.0
  },
  {
   "id": "vo3",
   "text": "Na budowie liczą się szczegóły. Kask. Kamizelka. Człowiek we właściwym miejscu.",
   "fallback": 3.0,
   "gain_db": 3.0
  },
  {
   "id": "vo4",
   "text": "Dlatego robot idzie pierwszy.",
   "fallback": 3.0,
   "gain_db": 3.0
  },
  {
   "id": "vo5",
   "text": "Autonomicznie. Mapuje przestrzeń. Zna swoją trasę.",
   "fallback": 3.0,
   "gain_db": 3.0
  },
  {
   "id": "vo6",
   "text": "I sprawdza najważniejsze. Kask i kamizelkę.",
   "fallback": 3.0,
   "gain_db": 3.0
  },
  {
   "id": "vo7",
   "text": "Nauczył się tego na tysiącach obrazów.",
   "fallback": 3.0,
   "gain_db": 3.0
  },
  {
   "id": "vo8",
   "text": "Kask jest. Kamizelka jest. Tu czegoś brakuje.",
   "fallback": 3.0,
   "gain_db": 3.0
  },
  {
   "id": "vo9",
   "text": "Gdy widzi różnicę, nie czeka. Oznacza miejsce. Informuje. Daje obraz i kontekst.",
   "fallback": 3.0,
   "gain_db": 3.0
  },
  {
   "id": "vo10",
   "text": "Robot nie zastępuje specjalisty BHP. Daje mu dodatkowe oczy na budowie.",
   "fallback": 3.0,
   "gain_db": 3.0
  },
  {
   "id": "vo11",
   "text": "DCS Robotics. Programujemy roboty, które widzą więcej.",
   "fallback": 3.0,
   "gain_db": 3.0
  }
 ],
