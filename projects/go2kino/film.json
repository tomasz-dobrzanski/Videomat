 "narration": [
  {
   "id": "j01",
   "text": "Na budowie liczy się każdy szczegół.",
   "say": null,
   "fallback": 2.22,
   "gain_db": 1.0
  },
  {
   "id": "j02",
   "text": "W dynamicznym środowisku bezpieczeństwo zależy od szybkiej identyfikacji zagrożeń.",
   "say": null,
   "fallback": 5.06,
   "gain_db": 1.0
  },
  {
   "id": "j03",
   "text": "Dlatego na najbardziej wymagające odcinki jako pierwszy wchodzi robot.",
   "say": null,
   "fallback": 4.44,
   "gain_db": 1.0
  },
  {
   "id": "j04",
   "text": "System skanerów i kamer tworzy precyzyjną mapę przestrzeni w czasie rzeczywistym.",
   "say": null,
   "fallback": 4.92,
   "gain_db": 1.0
  },
  {
   "id": "j05",
   "text": "Gdy pojawiają się nowe ściany i przeszkody, trasa dostosowuje się sama.",
   "say": null,
   "fallback": 4.7,
   "gain_db": 1.0
  },
  {
   "id": "j06",
   "text": "Sercem systemu jest zaawansowana analityka obrazu, wyszkolona na tysiącach rzeczywistych sytuacji.",
   "say": null,
   "fallback": 6.3,
   "gain_db": 1.0
  },
  {
   "id": "j07",
   "text": "Robot na bieżąco weryfikuje wyposażenie ochronne, obecność kasku czy kamizelki.",
   "say": null,
   "fallback": 5.58,
   "gain_db": 1.0
  },
  {
   "id": "j08",
   "text": "Gdy brakuje kluczowych elementów, zespół nadzoru dowiaduje się o tym natychmiast.",
   "say": null,
   "fallback": 4.88,
   "gain_db": 1.0
  },
  {
   "id": "j09",
   "text": "Urządzenie pokonuje schody, sprawdza kolejne kondygnacje i samodzielnie wraca do stacji ładowania.",
   "say": null,
   "fallback": 5.96,
   "gain_db": 1.0
  },
  {
   "id": "j10",
   "text": "To niezawodne, dodatkowe wsparcie dla inspektorów BHP.",
